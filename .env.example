# Deployment environment. Set to "production" (or "staging") to make
# app/startup_checks.py strict: an unset secret becomes a refusal to start
# instead of a silent default. Anything else only warns, so local dev and
# tests keep working with no .env at all.
ENVIRONMENT=development

# Base URL of the Firecrawl instance.
# Self-hosted (default): http://localhost:3002
# Cloud:                 https://api.firecrawl.dev
FIRECRAWL_API_URL=http://localhost:3002

# Optional for self-hosted (auth is bypassed). Required for cloud —
# get a key at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=self-hosted

# Default page limit per crawl if the request does not specify one.
DEFAULT_CRAWL_LIMIT=25

# Hard ceiling on pages per crawl.
MAX_CRAWL_LIMIT=100

# Milliseconds to wait for JavaScript to render each page before capturing it.
# Client-side-rendered sites (React/Next/Vue) return an empty shell without this.
DEFAULT_WAIT_FOR_MS=3000
MAX_WAIT_FOR_MS=15000

## === Ingestion (chunk -> embed -> vector DB) ===

# Postgres + pgvector connection string. Use a free Neon project in prod
# (https://neon.tech — enable nothing special, we run `CREATE EXTENSION vector`
# ourselves; append `?ssl=require` to the connection string, Neon requires
# SSL), or a local Docker container for dev:
#   docker run -d --name pgvector -p 5433:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Shared service-to-service secret required from any internal caller (the
# API gateway's forward proxy and the voice runtime both present it). Every
# endpoint except /health rejects requests without a matching Bearer token —
# leaving this empty means every request is rejected, not that auth is
# skipped. Must match GATEWAY_INGESTION_INTERNAL_TOKEN in api-gateway's
# .env and VOICE_INGESTION_INTERNAL_TOKEN in voice runtime gateway's .env.
INTERNAL_SERVICE_TOKEN=change-me

# Local, free embedding model (fastembed, ONNX/CPU, no API key). 384 dims —
# must match the `vector(384)` column in app/ingestion/store.py if changed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Explicit cache path for the fastembed model, rather than the OS temp dir —
# see app/config.py for why (Docker image baking, tmpfs /tmp risk).
EMBEDDING_CACHE_DIR=.fastembed_cache

# Automatically ingest a crawl into the vector DB once it finishes scraping.
AUTO_INGEST=true

# Chunking knobs (app/ingestion/chunker.py).
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150
CHUNK_MIN_CHARS=40

## === Doc2query: AI-generated questions per chunk ===

# Anthropic API key (https://platform.claude.com). Leave empty to skip
# question generation entirely — retrieval then falls back to pure dense search.
ANTHROPIC_API_KEY=

QUESTION_GEN_ENABLED=true
QUESTION_GEN_MODEL=claude-haiku-4-5
QUESTIONS_PER_CHUNK=3
QUESTION_GEN_BATCH_SIZE=12

## === Reranking: local cross-encoder re-scores results after hybrid+RRF ===
# Same fastembed/no-API-key footprint as EMBEDDING_MODEL above — shares its
# cache dir. Leave RERANK_ENABLED=false to skip this pass entirely.
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_CANDIDATE_CEILING=50

## === Sales script generation (app/salescript/) ===
# Uses the same ANTHROPIC_API_KEY as doc2query above.

SALES_SCRIPT_ENABLED=true
SALES_SCRIPT_EXTRACT_MODEL=claude-haiku-4-5
SALES_SCRIPT_MODEL=claude-sonnet-5
SALES_SCRIPT_MAX_REVISIONS=2
SALES_SCRIPT_MAX_PAGE_CHARS=8000
SALES_SCRIPT_PAGE_BATCH_SIZE=1
SALES_SCRIPT_MAX_CONCURRENT_EXTRACTIONS=4
SALES_SCRIPT_ANTHROPIC_MAX_RETRIES=3
SALES_SCRIPT_TIMEOUT_SECONDS=240
SALES_SCRIPT_RUN_TIMEOUT_SECONDS=1500
SALES_SCRIPT_MIN_EXTRACT_SUCCESS_RATIO=0.5

# LangSmith tracing for the sales-script LangGraph agent (optional — get a key
# at https://smith.langchain.com). Leave LANGCHAIN_API_KEY empty to disable.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=firecrawl-sales-script

## === Observability ===

# Logs go to stdout as one JSON object per line (set false for human-readable
# plain text in local dev). LOG_LEVEL is a standard Python logging level name.
LOG_LEVEL=INFO
LOG_JSON=true

# Error tracking (optional — get a DSN at https://sentry.io). Leave empty to
# skip Sentry entirely; nothing else here has any effect until it's set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
